\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the \textsc  {WinLIC}\xspace  {} processing pipeline. Multi-modal sensor data enters through the pluggable \texttt  {ISensorSource} abstraction, is synchronized by the DataAligner, fused into a dense depth map, completed by the SPNet TensorRT engine, and fed into the 3D Gaussian Splatting model for reconstruction.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{14}{Overview of the \winlic {} processing pipeline. Multi-modal sensor data enters through the pluggable \texttt {ISensorSource} abstraction, is synchronized by the DataAligner, fused into a dense depth map, completed by the SPNet TensorRT engine, and fed into the 3D Gaussian Splatting model for reconstruction}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The \texttt  {ISensorSource} abstract interface and its concrete implementations. The \texttt  {DatasetReader} handles offline file-based data, while the \texttt  {OrbbecSource} wraps the Orbbec SDK for live camera input. The interface is designed for extensibility: any future sensor SDK can be integrated by implementing four virtual methods.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:sensor_architecture}{{2}{15}{The \texttt {ISensorSource} abstract interface and its concrete implementations. The \texttt {DatasetReader} handles offline file-based data, while the \texttt {OrbbecSource} wraps the Orbbec SDK for live camera input. The interface is designed for extensibility: any future sensor SDK can be integrated by implementing four virtual methods}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Multi-modal depth fusion pipeline. Three depth sources---sparse LiDAR, dense iToF, and stereo SGM---are each assigned a confidence map. A weighted average produces the fused depth, after which LiDAR pixels overwrite the fused result as ground truth. The SPNet TensorRT engine completes remaining holes.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:depth_fusion}{{3}{15}{Multi-modal depth fusion pipeline. Three depth sources---sparse LiDAR, dense iToF, and stereo SGM---are each assigned a confidence map. A weighted average produces the fused depth, after which LiDAR pixels overwrite the fused result as ground truth. The SPNet TensorRT engine completes remaining holes}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Timestamp-based multi-modal data alignment. The LiDAR stream (10--20\,Hz) defines the reference timestamps. iToF, stereo, and IMU data are matched within a tolerance $\epsilon = 10$\,ms. Dashed vertical lines mark aligned frame instances $t_1, t_2, t_3$ where all modalities are synchronized.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:data_alignment}{{4}{16}{Timestamp-based multi-modal data alignment. The LiDAR stream (10--20\,Hz) defines the reference timestamps. iToF, stereo, and IMU data are matched within a tolerance $\epsilon = 10$\,ms. Dashed vertical lines mark aligned frame instances $t_1, t_2, t_3$ where all modalities are synchronized}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gaussian initialization from the fused point cloud. Each 3D point $\mathbf  {p}_i$ with colour $\mathbf  {c}_i$ and camera-frame depth $d_i$ is converted to a Gaussian primitive with position, SH colour coefficients, log-scale (derived from depth and focal length), identity rotation, and initial opacity. Optional skybox points are appended for open-environment scenes.}}{16}{figure.5}\protected@file@percent }
\newlabel{fig:gaussian_init}{{5}{16}{Gaussian initialization from the fused point cloud. Each 3D point $\mathbf {p}_i$ with colour $\mathbf {c}_i$ and camera-frame depth $d_i$ is converted to a Gaussian primitive with position, SH colour coefficients, log-scale (derived from depth and focal length), identity rotation, and initial opacity. Optional skybox points are appended for open-environment scenes}{figure.5}{}}
