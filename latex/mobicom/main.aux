\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cluster-head election FSM. All nodes start as FOLLOWER. On head heartbeat timeout, transition to CANDIDATE and broadcast ELECTION. If self.score is highest, become HEAD. If a head with higher score appears, demote to FOLLOWER.}}{16}{figure.caption.84}\protected@file@percent }
\newlabel{fig:election_fsm}{{6}{16}{Cluster-head election FSM. All nodes start as FOLLOWER. On head heartbeat timeout, transition to CANDIDATE and broadcast ELECTION. If self.score is highest, become HEAD. If a head with higher score appears, demote to FOLLOWER}{figure.caption.84}{}}
